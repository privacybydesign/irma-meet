APP_URL=https://meet.example.org

# 32 random bytes, base64 or hex. Generate with: openssl rand -base64 32
SESSION_KEY=

# The server needs read and write access only. Create the tables once with
# `irma-meet migrate`, using a user that may create tables.
# pgx tries TLS first (sslmode=prefer); add sslmode=require or verify-full to
# refuse a plain connection.
DATABASE_URL=postgresql://irmameet:password@127.0.0.1:5432/irmameet?connect_timeout=5

MAIL_HOST=smtp.tem.scw.cloud
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# starttls (default), tls (TLS on connect) or none
MAIL_ENCRYPTION=starttls
MAIL_FROM_ADDRESS=noreply@example.org
MAIL_FROM_NAME="Yivi Meet"

IRMA_SERVER_URL=https://irma.example.org
IRMA_API_TOKEN=
# string or json
IRMA_MEET_NAME_FORMAT=string

BBB_SERVER_BASE_URL=https://bbb.example.org/bigbluebutton/
BBB_SECRET=
